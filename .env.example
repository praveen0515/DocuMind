# =============================================================================
# DocuMind - Environment Configuration Template
# Copy this file to .env and provide your API keys before starting the server.
# =============================================================================

# --- Google Gemini Configuration ---
# Required: Get your Gemini API key from https://aistudio.google.com/
GOOGLE_API_KEY=your_google_gemini_api_key_here

# Embedding model to convert document chunks into vector representations
# Default: models/text-embedding-004
EMBEDDING_MODEL=models/text-embedding-004

# Generative model used for synthesis and cited responses
# Options: gemini-1.5-flash (fast, cost-effective), gemini-1.5-pro (complex reasoning)
LLM_MODEL=gemini-1.5-flash
LLM_TEMPERATURE=0.2
MAX_OUTPUT_TOKENS=2048

# --- Document Chunking & Retrieval Parameters ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K_RESULTS=4

# --- Storage & Persistence ---
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
UPLOAD_DIR=./data/uploads

# --- Server Settings ---
HOST=0.0.0.0
PORT=8000
DEBUG=false
MAX_UPLOAD_SIZE_MB=25
